<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>terraslam_solucion_dock_lidar</name>
  <version>1.0.0</version>
  <description>
    Solucion al Kalman Dock Challenge: docking del iRobot Create 3 usando solo
    el LiDAR, triangulando los bordes de las cajas marcadoras.
  </description>
  <maintainer email="patrick.echevarria.d@gmail.com">Patrick Echevarria</maintainer>
  <license>Apache-2.0</license>

  <author email="patrick.echevarria.d@gmail.com">Patrick Fabrizio Echevarria Duran</author>
  <author email="pradovasquezm@gmail.com">Marco Jesus Prado Vasquez</author>
  <author email="camilo.callupe.m@uni.pe">Camilo Roger Callupe Menejes</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
